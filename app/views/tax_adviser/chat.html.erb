<%= turbo_frame_tag "tax_adviser_panel" do %>
  <div class="ta-panel-header">
    <div>
      <div class="ta-panel-title">
        <%= @conversation.title %>
      </div>

      <div class="ta-panel-subtitle">
        Ask about gigs, expenses & taxes
      </div>
    </div>

    <div class="ta-panel-actions">
      <%= link_to "History",
                  tax_adviser_path,
                  class: "btn btn-sm btn-outline-dark rounded-3",
                  data: { turbo_frame: "_top" } %>

      <%= button_to "New",
                    tax_adviser_chats_path,
                    method: :post,
                    class: "btn btn-sm btn-dark rounded-3" %>

      <button type="button"
              class="ta-panel-close"
              data-action="tax-adviser-widget#close"
              aria-label="Close chat">&times;</button>
    </div>
  </div>

  <% if flash[:alert] %>
    <div class="alert alert-warning ta-panel-alert mb-0" role="alert">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <div class="ta-panel-messages" data-tax-adviser-widget-target="messages">
    <% if @messages.any? %>
      <% @messages.each do |message| %>
        <div class="ta-message-row ta-sender-row">
          <div class="ta-sender-style">
            <div class="ta-message-name">You</div>

            <div>
              <%= message.question %>
            </div>
          </div>
        </div>

        <div class="ta-message-row ta-receiver-row">
          <div class="ta-receiver-style">
            <div class="ta-message-name">Coda</div>

            <div>
              <%= render_adviser_answer(message.answer) %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-muted text-center small py-4 mb-0">
        Ask your first question to begin this chat.
      </p>
    <% end %>
  </div>

  <div class="ta-panel-form">
    <%= form_with url: ask_tax_adviser_chat_path(@conversation),
                  method: :post,
                  html: {
                    onsubmit: "
                      const button = this.querySelector('input[type=submit]');
                      button.value = 'Thinking...';
                      button.disabled = true;
                      this.querySelector('.ta-panel-loading').classList.remove('d-none');
                    "
                  } do |form| %>

      <%= form.text_area :question,
                         rows: 2,
                         class: "form-control mb-2",
                         placeholder: @messages.any? ?
                           "Ask a follow-up..." :
                           "Which gig was most profitable this year?",
                         autofocus: true %>

      <div class="d-flex justify-content-end">
        <%= form.submit "Ask Coda", class: "btn btn-dark btn-sm rounded-3 px-3" %>
      </div>

      <div class="ta-panel-loading d-none">
        <div class="progress" style="height: 4px;">
          <div class="progress-bar progress-bar-striped progress-bar-animated w-100"></div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
