<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
      <h1>Company details</h1>
      <p class="text-muted">Tell us about your business.</p>

      <%= simple_form_for @company, url: company_path, method: :patch do |f| %>
        <%= f.error_notification %>

        <%= f.input :company_name, required: true %>
        <%= f.input :tax_id, label: "Tax ID", required: true %>
        <%= f.input :country_code,
                    label: "Country",
                    collection: Entry::COUNTRIES,
                    include_blank: "Choose…",
                    required: true %>
        <%= f.input :default_currency,
                    label: "Default currency",
                    collection: Entry::CURRENCIES,
                    include_blank: "Choose…",
                    required: true,
                    hint: "Everything gets converted to this for your summaries" %>

        <div class="form-actions">
          <%= f.button :submit, "Save", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
