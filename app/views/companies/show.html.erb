<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Company details</h1>

        <%= link_to "Edit", edit_company_path, class: "btn btn-outline-primary btn-sm" %>
      </div>

      <dl>
        <dt>Company name</dt>
        <dd><%= @company.company_name.presence || "—" %></dd>

        <dt>Tax ID</dt>
        <dd><%= @company.tax_id.presence || "—" %></dd>

        <dt>Country</dt>
        <dd><%= country_name(@company.country_code) %></dd>

        <dt>Default currency</dt>
        <dd><%= @company.default_currency.presence || "—" %></dd>
      </dl>
    </div>
  </div>
</div>
