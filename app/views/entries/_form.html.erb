<%= simple_form_for @entry do |f| %>
  <%= f.error_notification %>

  <%= f.input :kind, collection: Entry.kinds.keys, include_blank: false %>
  <%= f.input :category, collection: Entry.categories.keys.map { |c| [c.humanize, c] },
              include_blank: "Choose…" %>
  <%= f.input :amount, input_html: { step: "0.01", min: 0 } %>
  <%= f.input :currency, collection: Entry::CURRENCIES, include_blank: false %>
  <%= f.input :entry_date, as: :date, html5: true %>
  <%= f.input :country_code, collection: %w[GB DE FR AT US ES IT NL],
              include_blank: "Choose…",
              hint: "Where the money was earned or spent" %>
  <%= f.association :gig, collection: current_user.gigs.order(start_date: :desc),
              label_method: ->(g) { "#{g.name} — #{g.city}" },
              include_blank: false,
              input_html: {
                id: "entry_gig_select",
                data: { controller: "gig-select", action: "change->gig-select#change" }
              } %>
  <%= f.input :description %>

  <% if f.object.new_record? && f.object.receipt.attached? %>
    <%= f.hidden_field :receipt, value: f.object.receipt.blob.signed_id %>
    <p class="text-muted small mb-3">
      Receipt: <%= f.object.receipt.filename %> (from uploaded document)
    </p>
  <% else %>
    <% if f.object.receipt.attached? %>
      <div class="mb-2">
        <% if f.object.receipt.image? %>
          <%= image_tag f.object.receipt, class: "img-fluid mb-2 d-block", style: "max-width: 200px" %>
        <% end %>
        <p class="text-muted small mb-2">
          Current receipt:
          <%= link_to f.object.receipt.filename, rails_blob_path(f.object.receipt, disposition: "attachment") %>
        </p>
      </div>
    <% end %>

    <%= f.input :receipt, as: :file,
          hint: (f.object.receipt.attached? ? "Upload a file to replace the current receipt" : nil) %>
  <% end %>

  <%= f.button :submit, class: "btn btn-primary" %>
<% end %>

<%= render "gigs/quick_create_modal" %>
