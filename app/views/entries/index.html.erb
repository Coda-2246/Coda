<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="mb-0">Entries</h1>

    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newEntryModal">
      New entry
    </button>
  </div>

  <%= form_with url: entries_path, method: :get, class: "row g-2 mb-4" do |form| %>
    <div class="col-md-4">
      <%= form.text_field :query,
          value: params[:query],
          placeholder: "Search entries",
          class: "form-control" %>
    </div>

    <div class="col-md-3">
      <%= form.text_field :country,
          value: params[:country],
          placeholder: "Country code",
          class: "form-control" %>
    </div>

    <div class="col-md-3">
      <%= form.text_field :date_range,
          value: params[:date_range],
          placeholder: "Select date range",
          class: "form-control",
          data: { controller: "flatpickr" } %>
    </div>

    <div class="col-md-2 d-flex gap-2">
      <%= form.submit "Search", class: "btn btn-primary" %>
      <%= link_to "Clear", entries_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>

  <% if @entries.any? %>
    <% @entries.each do |entry| %>
      <div class="card mb-3">
        <div class="card-body">
          <h3 class="h5">
            <%= link_to entry.description.presence || "Untitled entry",
                        entry,
                        class: "link-primary text-decoration-underline fw-semibold" %>
          </h3>

          <p class="mb-1">
            <%= entry.kind.humanize %> —
            <strong><%= money(entry.amount, entry.currency) %></strong>
          </p>

          <p class="text-muted mb-1">
            Country: <%= country_name(entry.country_code) %>
          </p>

          <p class="text-muted mb-0">
            Date: <%= entry.entry_date.strftime("%d %b %Y") %>
          </p>
        </div>
      </div>
    <% end %>
  <% else %>
    <p>No entries found.</p>
  <% end %>

  <div class="modal fade" id="newEntryModal" tabindex="-1" aria-labelledby="newEntryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="newEntryModalLabel">New entry</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <p class="text-muted">How would you like to add this entry?</p>

          <div class="d-grid mb-4">
            <%= link_to "Enter manually", new_entry_path, class: "btn btn-outline-primary" %>
          </div>

          <hr>

          <p class="fw-semibold mb-2">Or upload a receipt/invoice</p>

          <%= form_with url: extract_entries_path, method: :post, multipart: true do |f| %>
            <div class="mb-2">
              <%= f.file_field :document,
                    accept: "image/*,.pdf",
                    class: "form-control",
                    required: true %>
            </div>

            <div class="d-grid">
              <%= f.submit "Upload document & extract",
                    class: "btn btn-primary",
                    data: { turbo_submits_with: "Extracting…" } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
