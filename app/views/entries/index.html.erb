<h1>Entries</h1>

<%= form_with url: entries_path, method: :get do |form| %>
  <%= form.text_field :query,
      value: params[:query],
      placeholder: "Search entries",
      class: "form-control" %>

  <%= form.text_field :country,
      value: params[:country],
      placeholder: "Country code",
      class: "form-control" %>

  <%= form.text_field :date_range,
      value: params[:date_range],
      placeholder: "Select date range",
      class: "form-control",
      data: { controller: "flatpickr" } %>

  <%= form.submit "Search" %>

  <%= link_to "Clear", entries_path %>
<% end %>

<hr>

<% if @entries.any? %>
  <% @entries.each do |entry| %>
    <div>
      <h3><%= entry.description.presence || "Untitled entry" %></h3>

      <p>
        <%= entry.kind %> —
        <%= entry.amount %>
        <%= entry.currency %>
      </p>

      <p>
        Country: <%= entry.country_code.presence || "Not specified" %>
      </p>

      <p>
        Date: <%= entry.entry_date %>
      </p>
    </div>

    <hr>
  <% end %>
<% else %>
  <p>No entries found.</p>
<% end %>
