<div class="container py-5">
  <h1>Coda</h1>

  <p class="lead">
    Cross-border freelance finance, sorted.
  </p>

  <p class="text-muted">
    Track gigs, income and expenses across countries and currencies.
  </p>

  <div class="d-flex flex-wrap gap-2">
    <% if user_signed_in? %>
      <%= link_to "Go to dashboard", dashboard_path, class: "btn btn-primary" %>
      <%= link_to "Log an entry", new_entry_path, class: "btn btn-outline-primary" %>
    <% else %>
      <%= link_to "Get started", new_user_registration_path, class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
