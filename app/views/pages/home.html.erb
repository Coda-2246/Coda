<div class="container py-5">
  <h1>Coda</h1>

  <p class="lead">
    Cross-border freelance finance, sorted.
  </p>

  <p class="text-muted">
    Track gigs, income and expenses across countries and currencies.
  </p>

  <div class="d-flex flex-wrap gap-2">
    <% if user_signed_in? %>
      <%= link_to "Go to dashboard", dashboard_path, class: "btn btn-primary" %>
      <button type="button"
              class="btn btn-outline-primary"
              data-bs-toggle="modal"
              data-bs-target="#newEntryModal">
        Log an entry
      </button>
    <% else %>
      <%= link_to "Get started", new_user_registration_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <%= render "entries/new_entry_modal" if user_signed_in? %>
</div>
