<div class="container py-4">
  <h1><%= @gig.name %></h1>

  <p class="text-muted">
    <%= [@gig.venue, @gig.city, country_name(@gig.country_code)].compact_blank.join(" · ") %>
  </p>

  <p>
    <%= @gig.date_range %> ·
    <span class="badge bg-secondary"><%= @gig.status.humanize %></span>
  </p>

  <% if @gig.fee_amount.present? %>
    <p>
      Agreed fee:
      <strong><%= money(@gig.fee_amount, @gig.fee_currency) %></strong>
    </p>
  <% end %>

  <hr>

  <div class="row mb-4">
    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <strong>Income</strong><br>
          <%= money(@gig.total_income, current_user.home_currency) %>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <strong>Expenses</strong><br>
          <%= money(@gig.total_expenses, current_user.home_currency) %>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <strong>Net</strong><br>
          <%= money(@gig.net, current_user.home_currency) %>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="mb-0">Entries</h3>

    <%= link_to "Log an entry for this gig",
                new_entry_path(gig_id: @gig.id),
                class: "btn btn-sm btn-outline-primary" %>
  </div>

  <% if @entries.any? %>
    <ul class="list-group mb-4">
      <% @entries.each do |entry| %>
        <li class="list-group-item">
          <%= link_to entry.description.presence || "Untitled entry", entry %>

          —
          <%= entry.kind.humanize %> ·
          <%= money(entry.amount, entry.currency) %>

          <% if entry.amount_home.present? %>
            <small class="text-muted">
              (<%= money(entry.amount_home, current_user.home_currency) %>)
            </small>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No entries for this gig yet.</p>
  <% end %>

  <div class="d-flex flex-wrap gap-2">
    <%= link_to "Edit", edit_gig_path(@gig), class: "btn btn-outline-secondary" %>

    <%= link_to "Delete",
                gig_path(@gig),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Delete this gig? Its entries will be kept."
                },
                class: "btn btn-outline-danger" %>

    <%= link_to "Back", gigs_path, class: "btn btn-link" %>
  </div>
</div>
