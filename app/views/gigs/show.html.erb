<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <h1 class="mb-0"><%= @gig.name %></h1>

    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Edit", edit_gig_path(@gig), class: "btn btn-outline-secondary" %>

      <%= link_to "Delete",
                  gig_path(@gig),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Delete this gig? Its entries will be kept."
                  },
                  class: "btn btn-outline-danger" %>
    </div>
  </div>

  <p class="text-muted">
    <%= [@gig.venue, @gig.city, country_name(@gig.country_code)].compact_blank.join(" · ") %>
  </p>

  <p>
    <%= @gig.date_range %> ·
    <span class="badge bg-secondary"><%= @gig.status.humanize %></span>
  </p>

  <% if @gig.fee_amount.present? %>
    <p>
      Agreed fee:
      <strong><%= money(@gig.fee_amount, @gig.fee_currency) %></strong>
    </p>
  <% end %>

  <hr>

  <div class="row mb-4">
    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <strong>Income</strong><br>
          <%= money(@gig.total_income, current_user.home_currency) %>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <strong>Expenses</strong><br>
          <%= money(@gig.total_expenses, current_user.home_currency) %>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <strong>Net</strong><br>
          <span class="<%= net_amount_color_class(@gig.net) %>">
            <%= money(@gig.net, current_user.home_currency) %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h3 class="mb-0">Entries</h3>

    <button type="button"
            class="btn btn-sm btn-outline-primary"
            data-bs-toggle="modal"
            data-bs-target="#newEntryModal">
      Log an entry for this gig
    </button>
  </div>

  <% if @entries.any? %>
    <div class="row">
      <% @entries.each do |entry| %>
        <div class="col-md-4 mb-3">
          <div class="card h-100">
            <div class="card-body">
              <h3 class="h5">
                <%= link_to entry.description.presence || "Untitled entry",
                            entry,
                            class: "link-primary text-decoration-underline fw-semibold" %>
              </h3>

              <p class="mb-1">
                <%= entry.kind.humanize %> —
                <strong><%= money(entry.amount, entry.currency) %></strong>

                <% if entry.amount_home.present? %>
                  <span class="text-muted">
                    (<%= money(entry.amount_home, current_user.home_currency) %>)
                  </span>
                <% end %>
              </p>

              <p class="text-muted mb-0">
                Date: <%= entry.entry_date.strftime("%d %b %Y") %>
              </p>

              <div class="d-flex flex-wrap gap-2 mt-3">
                <%= link_to "Edit", edit_entry_path(entry), class: "btn btn-sm btn-outline-secondary" %>

                <%= link_to "Delete",
                      entry_path(entry),
                      data: { turbo_method: :delete, turbo_confirm: "Delete this entry?" },
                      class: "btn btn-sm btn-outline-danger" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No entries for this gig yet.</p>
  <% end %>

  <%= render "entries/new_entry_modal", gig_id: @gig.id %>
</div>
